<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.camera.CameraFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent=".05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glCameraTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent=".01" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glCameraBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent=".80" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glCameraEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent=".60" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glCameraStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent=".01" />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="573dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glScaleEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent=".65" />


    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llButtonBar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:weightSum="8"
        android:orientation="vertical"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/glCameraBottom"
        app:layout_constraintEnd_toStartOf="@+id/ivCamera"
        app:layout_constraintStart_toStartOf="@+id/glCameraStart"
        app:layout_constraintTop_toTopOf="@+id/glCameraTop">

        <Button
            android:id="@+id/btnS"
            style="@style/SmallBtn"
            android:text="S   "/>

        <Button
            style="@style/SmallBtn"
            android:text="M1 "/>

        <Button
            style="@style/SmallBtn"
            android:text="M2 "/>

        <Button
            style="@style/SmallBtn"
            android:text="M3 "/>

        <Button
            android:id="@+id/btnFFC"
            style="@style/SmallBtn"
            android:text="FFC"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <ImageView
        android:id="@+id/ivCamera"
        android:layout_width="320dp"
        android:layout_height="240dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/glCameraBottom"
        app:layout_constraintEnd_toEndOf="@+id/glCameraEnd"
        app:layout_constraintStart_toEndOf="@+id/llButtonBar"
        app:layout_constraintTop_toTopOf="@+id/glCameraTop"
        tools:srcCompat="@drawable/main_camera" />

    <ImageView
        android:layout_width="20sp"
        android:layout_height="240dp"
        android:scaleType="fitXY"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/glCameraBottom"
        app:layout_constraintEnd_toEndOf="@+id/glCameraEnd"
        app:layout_constraintStart_toEndOf="@+id/ivCamera"
        app:layout_constraintTop_toTopOf="@+id/glCameraTop" />



</androidx.constraintlayout.widget.ConstraintLayout>