<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="listener"
            type="com.darcangel.acam.ui.settings.SettingsListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ui.settings.SettingsFragment">


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent=".05" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent=".95" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".05" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".95" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/glTop">

            <!--Scrollview Container-->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart">

                <!--Heading-->
                <TextView
                    style="@style/SettingsHeading"
                    android:text="@string/camera_settings"
                    android:textAllCaps="true"/>

                <!--AGC-->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAGC"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="10sp"
                    android:layout_weight="1"
                    android:onCheckedChanged="@{(buttonView, isChecked) -> listener.onSwitchChanged(buttonView, isChecked)}"
                    android:text="@string/agc" />

                <!--Emissivity-->
                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SettingsLayout">

                    <TextView
                        style="@style/SettingsTextStart"
                        android:text="@string/emissivity" />

                    <EditText
                        style="@style/SettingsEditTextEnd"
                        android:id="@+id/etEmissivity"
                        android:inputType="numberDecimal"
                        android:afterTextChanged="@{(text) -> listener.onEmissivityTextChanged(text)}"
                        android:onFocusChange="@{(v, hasFocus) -> listener.onFocusChange(v, hasFocus)}"
                        android:textAlignment="textEnd" />

                    <ImageButton
                        style="@style/SettingsBtnEnd"
                        android:id="@+id/btnEmissivityHint"
                        android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                        android:onClick="@{(buttonView) -> listener.onButtonClicked(buttonView)}" />

<!--
                    <Spinner
                        style="@style/SettingsTextEnd"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/spEmissivity"
                        android:entries="@array/emissivity_strings"
                        android:onItemSelected="@{(parent, view, pos, id) -> listener.onItemSelected(parent, view, pos, id)}"
                        android:onNothingSelected="@{(parent) -> listener.onNothingSelected(parent)}"/>
-->
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!--Gain Radio Buttons-->
                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SettingsLayout">

                    <TextView
                        style="@style/SettingsTextStart"
                        android:layout_gravity="center_vertical"
                        android:text="@string/gain" />

                    <RadioGroup
                        android:id="@+id/rgGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:onCheckedChanged="@{(group, checkedId) -> listener.onRadioGroupChanged(group, checkedId)}">

                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rbGainAuto"
                            style="@style/SettingsRadioButton"
                            android:checked="true"
                            android:text="@string/auto" />

                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rbGainHigh"
                            style="@style/SettingsRadioButton"
                            android:checked="false"
                            android:text="@string/high" />

                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rbGainLow"
                            style="@style/SettingsRadioButton"
                            android:checked="false"
                            android:text="@string/low" />
                    </RadioGroup>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!--Heading-->
                <TextView
                    style="@style/SettingsHeading"
                    android:text="@string/wifi_network"
                    android:textAllCaps="false" />


                <!--Heading-->
                <TextView
                    style="@style/SettingsHeading"
                    android:text="@string/application_settings" />

                <!--Camera IP Address-->
                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SettingsLayout">

                    <TextView
                        style="@style/SettingsTextStart"
                        android:layout_gravity="center_vertical"
                        android:text="@string/camera_ip_address" />

                    <EditText
                        style="@style/SettingsEditTextEnd"
                        android:id="@+id/cameraIPAddress"
                        android:inputType="textUri"
                        android:afterTextChanged="@{(text) -> listener.onCameraIPAddressChanged(text)}"
                        android:onFocusChange="@{(v, hasFocus) -> listener.onFocusChange(v, hasFocus)}"
                        android:textAlignment="textEnd" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!--Export Picture on Save-->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSavePictureOnSave"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="10sp"
                    android:layout_weight="1"
                    android:onCheckedChanged="@{(buttonView, isChecked) -> listener.onSwitchChanged(buttonView, isChecked)}"
                    android:text="@string/save_picture_on_save" />

                <!--Export MetaData-->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchExportMetadata"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="10sp"
                    android:layout_weight="1"
                    android:onCheckedChanged="@{(buttonView, isChecked) -> listener.onSwitchChanged(buttonView, isChecked)}"
                    android:text="@string/export_metadata" />

                <!--Export Resolution-->
                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SettingsLayout">

                    <TextView
                        style="@style/SettingsTextStart"
                        android:text="@string/export_resolution" />

                    <ImageButton
                        style="@style/SettingsBtnEnd"
                        android:id="@+id/btnExportResolution"
                        android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                        android:onClick="@{(buttonView) -> listener.onButtonClicked(buttonView)}" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!--Manual Range-->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchManualRange"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="10sp"
                    android:layout_weight="1"
                    android:onCheckedChanged="@{(buttonView, isChecked) -> listener.onSwitchChanged(buttonView, isChecked)}"
                    android:text="@string/manual_range" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/SettingsLayout"
                    android:id="@+id/layoutManualRange"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!--Min-->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/SettingsLayout">

                        <TextView
                            style="@style/SettingsTextStart"
                            android:text="@string/min"/>

                        <EditText
                            style="@style/SettingsEditTextEnd"
                            android:inputType="number"
                            android:afterTextChanged="@{(text) -> listener.onMinRangeTextChanged(text)}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!--Max-->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/SettingsLayout">

                        <TextView
                            style="@style/SettingsTextStart"
                            android:text="@string/max"/>

                        <EditText
                            style="@style/SettingsEditTextEnd"
                            android:inputType="number"
                            android:afterTextChanged="@{(text) -> listener.onMaxRangeTextChanged(text)}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SettingsLayout">

                    <TextView
                        style="@style/SettingsBtnStart"
                        android:text="@string/palette" />

                    <ImageButton
                        style="@style/SettingsBtnEnd"
                        android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!--Shutter Sound-->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchShutterSound"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="10sp"
                    android:layout_weight="1"
                    android:onCheckedChanged="@{(buttonView, isChecked) -> listener.onSwitchChanged(buttonView, isChecked)}"
                    android:text="@string/shutter_sound" />

                <!--Spotmeter-->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSpotMeter"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="10sp"
                    android:layout_weight="1"
                    android:onCheckedChanged="@{(buttonView, isChecked) -> listener.onSwitchChanged(buttonView, isChecked)}"
                    android:text="@string/spotmeter" />

                <!--Units-->
                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SettingsLayout">

                    <TextView
                        style="@style/SettingsTextStart"
                        android:layout_gravity="center_vertical"
                        android:text="@string/units" />

                    <RadioGroup
                        android:id="@+id/rgUnits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rbUnitsF"
                            style="@style/SettingsRadioButton"
                            android:checked="true"
                            android:text="&#xb0;F" />

                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/rbUnitsC"
                            style="@style/SettingsRadioButton"
                            android:checked="false"
                            android:text="&#xb0;C" />

                    </RadioGroup>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!--Version-->
                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SettingsLayout">

                    <TextView
                        style="@style/SettingsTextStart"
                        android:text="@string/version" />

                    <TextView
                        style="@style/SettingsTextEnd"
                        android:text="0.1.0" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!--Privacy Policy-->
                <androidx.appcompat.widget.LinearLayoutCompat style="@style/SettingsLayout">

                    <TextView
                        style="@style/SettingsTextStart"
                        android:text="@string/privacy_policy" />

                    <ImageButton
                        style="@style/SettingsBtnEnd"
                        android:src="@drawable/ic_baseline_keyboard_arrow_right_24" />
                </androidx.appcompat.widget.LinearLayoutCompat>


                <!--End of scrollable context-->
            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>